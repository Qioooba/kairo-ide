# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# Node
node_modules/
.pnpm-store/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Theia / Electron
apps/*/lib/
apps/*/out/
apps/*/gen/
apps/*/dist/
apps/desktop/.theia/
apps/browser/.theia/
apps/server/.theia/
packages/*/lib/
packages/*/out/

# Go
runtime-agent/kairo-runtime
runtime-agent/bin/
runtime-agent/dist/
runtime-agent/coverage.out
*.test
*.prof

# Build artifacts
build/
release/
dist/
*.zip
*.tar.gz
*.dmg
*.exe
*.AppImage
*.deb
*.rpm

# Runtime / state
.runtime/
*.pid
*.sock
.runtime-tmp/

# Test fixtures
tests/e2e/screenshots/*.actual.png
tests/e2e/screenshots/*.diff.png
test-results/
playwright-report/
playwright/.cache/

# Logs
logs/
*.log

# Bundled third-party (large)
bundled/tomcat6/apache-tomcat-*/
bundled/tomcat6/bin/
bundled/tomcat6/lib/
bundled/tomcat6/conf/
bundled/tomcat6/logs/
bundled/tomcat6/temp/
bundled/tomcat6/work/
bundled/tomcat6/webapps/
bundled/jdk*/
bundled/jre*/
bundled/eclipse-jdt-ls/
# Pre-stage dir for electron-builder — populated by
# `pnpm --filter @kairo/desktop build:win` from bundled/ at
# packaging time, then removed by clean().
apps/desktop/bundled/

# Local user state
.legacyflow/
.user/
.config/

# Sample project transient
legacy-sample/build/
legacy-sample/dist/
legacy-sample/work/
legacy-sample/temp/
legacy-sample/logs/
legacy-sample/.settings/
legacy-sample/.classpath
legacy-sample/.project

# Generated
docs/api/
*.generated.ts
*.generated.go

# TypeScript build outputs
*.tsbuildinfo
packages/*/src/**/*.d.ts
packages/*/src/**/*.js
packages/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.js
apps/*/src/**/*.js.map

# Theia-generated esbuild config (re-emitted on every `theia build`)
apps/*/esbuild.mjs
apps/*/gen-esbuild.*.mjs
apps/*/src-gen/

# Playwright screenshots (not test artifacts, just visual reference)
codex-ui-review-shots/

# raw test output (kept as scratch; full reports go under docs/progress/)
**/*.test-output.txt
**/runtime-test-raw.txt
**/api-smoke-raw.txt
**/probe-raw.txt

# Acceptance / verification scratch (10k-file benchmarks, install
# dirs, in-progress evidence bundles). Real reports go to
# docs/progress/. Keep these out of git to avoid a 10000-file
# commit every time a verification cycle is run locally.
artifacts/acceptance-*/
artifacts/windows-wave2/
artifacts/windows-wave2-r1-prev-*/

# Local scratch files (test probes, one-off scripts)
scratchpad/

