#!/usr/bin/env sh
# Kairo IDE pre-commit hook
#
# Runs on every commit to ensure code quality:
#   1. Go formatting (gofmt)
#   2. Go vet
#   3. TypeScript type check (changed files only)
#   4. Lint (changed files only)
#
# To skip (not recommended): git commit --no-verify

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Resolve repository root
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Detect if running on Windows (Git Bash / MSYS2)
IS_WINDOWS=0
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=1 ;;
esac

echo "${GREEN}[pre-commit] Kairo IDE pre-commit checks${NC}"

# ---------------------------------------------------------------------------
# 1. Go formatting check (gofmt)
# ---------------------------------------------------------------------------
echo "${YELLOW}[pre-commit] Checking Go formatting...${NC}"

if command -v gofmt >/dev/null 2>&1; then
  GO_AGENT_DIR="$REPO_ROOT/runtime-agent"
  if [ -d "$GO_AGENT_DIR" ]; then
    # Only check staged Go files
    STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

    if [ -n "$STAGED_GO_FILES" ]; then
      echo "  Checking staged Go files..."
      for file in $STAGED_GO_FILES; do
        if [ -f "$REPO_ROOT/$file" ]; then
          # Check if gofmt would change this file
          UNFORMATTED=$(gofmt -l "$REPO_ROOT/$file" 2>/dev/null || true)
          if [ -n "$UNFORMATTED" ]; then
            echo "${RED}  ERROR: $file is not gofmt-clean${NC}"
            echo "  Run: gofmt -w $file"
            HAS_ERRORS=1
          fi
        fi
      done
    else
      # No staged Go files, check all Go files in runtime-agent
      if [ -f "$GO_AGENT_DIR/go.mod" ]; then
        echo "  No staged Go files; checking all Go files in runtime-agent..."
        UNFORMATTED=$(gofmt -l "$GO_AGENT_DIR" 2>/dev/null || true)
        if [ -n "$UNFORMATTED" ]; then
          echo "${RED}  ERROR: Some Go files are not gofmt-clean:${NC}"
          echo "$UNFORMATTED"
          echo "  Run: cd runtime-agent && gofmt -w ."
          HAS_ERRORS=1
        else
          echo "  ${GREEN}All Go files are gofmt-clean${NC}"
        fi
      fi
    fi
  fi
else
  echo "  ${YELLOW}gofmt not found — skipping${NC}"
fi

# ---------------------------------------------------------------------------
# 2. Go vet
# ---------------------------------------------------------------------------
echo "${YELLOW}[pre-commit] Running go vet...${NC}"

if command -v go >/dev/null 2>&1; then
  GO_AGENT_DIR="$REPO_ROOT/runtime-agent"
  if [ -d "$GO_AGENT_DIR" ] && [ -f "$GO_AGENT_DIR/go.mod" ]; then
    STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
    if [ -n "$STAGED_GO_FILES" ]; then
      echo "  Running go vet on staged Go files..."
      # Get unique packages from staged files
      STAGED_PKGS=$(echo "$STAGED_GO_FILES" | sed 's|/[^/]*$||' | sort -u | sed 's|^|./|' || true)
      for pkg in $STAGED_PKGS; do
        if [ -d "$GO_AGENT_DIR/$pkg" ]; then
          (cd "$GO_AGENT_DIR" && go vet "$pkg/..." 2>&1) || {
            echo "${RED}  go vet failed for $pkg${NC}"
            HAS_ERRORS=1
          }
        fi
      done
    else
      echo "  Running go vet on all packages..."
      (cd "$GO_AGENT_DIR" && go vet ./... 2>&1) || {
        echo "${RED}  go vet failed${NC}"
        HAS_ERRORS=1
      }
    fi
  fi
else
  echo "  ${YELLOW}go not found — skipping${NC}"
fi

# ---------------------------------------------------------------------------
# 3. TypeScript type check (changed files only)
# ---------------------------------------------------------------------------
echo "${YELLOW}[pre-commit] Checking TypeScript types...${NC}"

if command -v npx >/dev/null 2>&1; then
  STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

  if [ -n "$STAGED_TS_FILES" ]; then
    echo "  Found $(echo "$STAGED_TS_FILES" | wc -l | tr -d ' ') staged TypeScript file(s)"

    # Determine which packages have changes
    STAGED_PACKAGES=""
    for file in $STAGED_TS_FILES; do
      pkg=$(echo "$file" | sed -n 's|^packages/\([^/]*\)/.*|\1|p')
      if [ -n "$pkg" ] && ! echo "$STAGED_PACKAGES" | grep -q "$pkg"; then
        STAGED_PACKAGES="$STAGED_PACKAGES packages/$pkg"
      fi
    done

    if [ -n "$STAGED_PACKAGES" ]; then
      echo "  Running tsc --noEmit on changed packages:$STAGED_PACKAGES"
      for pkg in $STAGED_PACKAGES; do
        if [ -f "$REPO_ROOT/$pkg/tsconfig.json" ]; then
          echo "    Checking $pkg..."
          (cd "$REPO_ROOT/$pkg" && npx tsc --noEmit 2>&1) || {
            echo "${RED}  TypeScript type check failed for $pkg${NC}"
            HAS_ERRORS=1
          }
        fi
      done
    else
      echo "  No package-level TypeScript files staged; running full type check..."
      npx tsc --noEmit 2>&1 || {
        echo "${RED}  TypeScript type check failed${NC}"
        HAS_ERRORS=1
      }
    fi
  else
    echo "  No staged TypeScript files — skipping"
  fi
else
  echo "  ${YELLOW}npx not found — skipping${NC}"
fi

# ---------------------------------------------------------------------------
# 4. Lint (changed files only)
# ---------------------------------------------------------------------------
echo "${YELLOW}[pre-commit] Running lint...${NC}"

if command -v npx >/dev/null 2>&1; then
  STAGED_JS_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|cjs|mjs)$' || true)

  if [ -n "$STAGED_JS_TS_FILES" ]; then
    echo "  Found $(echo "$STAGED_JS_TS_FILES" | wc -l | tr -d ' ') staged JS/TS file(s)"

    # Run eslint on staged files only (for-loop so HAS_ERRORS is not lost in a subshell)
    for file in $STAGED_JS_TS_FILES; do
      if [ -f "$REPO_ROOT/$file" ]; then
        npx eslint --max-warnings 0 "$REPO_ROOT/$file" 2>&1 || {
          echo "${RED}  Lint failed for $file${NC}"
          HAS_ERRORS=1
        }
      fi
    done
  else
    echo "  No staged JS/TS files — skipping lint"
  fi
else
  echo "  ${YELLOW}eslint not found — skipping${NC}"
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
if [ -n "${HAS_ERRORS}" ]; then
  echo ""
  echo "${RED}========================================${NC}"
  echo "${RED}  pre-commit checks FAILED${NC}"
  echo "${RED}========================================${NC}"
  echo ""
  echo "Please fix the errors above and try again."
  echo "To bypass (not recommended): git commit --no-verify"
  exit 1
fi

echo ""
echo "${GREEN}========================================${NC}"
echo "${GREEN}  pre-commit checks PASSED${NC}"
echo "${GREEN}========================================${NC}"
exit 0