{
  "name": "@kairo/desktop",
  "version": "0.1.0",
  "description": "Kairo IDE — desktop entry. Electron shell + Theia frontend + in-process Go Runtime Agent.",
  "private": true,
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prebuild": "cd ../../runtime-agent && go build -o bin/kairo-runtime ./cmd/kairo-runtime",
    "build:mac": "tsc -p tsconfig.json && electron-builder --mac",
    "build:win": "tsc -p tsconfig.json && electron-builder --win",
    "build:linux": "tsc -p tsconfig.json && electron-builder --linux",
    "build:all": "tsc -p tsconfig.json && electron-builder --mac --win --linux",
    "start": "electron lib/main.js",
    "clean": "rm -rf lib dist"
  },
  "dependencies": {
    "@kairo/theia-product": "workspace:*",
    "@kairo/runtime-extension": "workspace:*",
    "@theia/core": "1.73.1",
    "@theia/electron": "1.73.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "electron": "39.8.7",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.kairo.ide",
    "productName": "Kairo IDE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "lib/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../../runtime-agent/kairo-runtime",
        "to": "kairo-runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
