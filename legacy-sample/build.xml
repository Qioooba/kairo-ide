<?xml version="1.0" encoding="UTF-8"?>
<project name="kairo-legacy-sample" default="compile" basedir=".">

  <property name="src.dir"     value="src/main/java"/>
  <property name="res.dir"     value="src/main/resources"/>
  <property name="lib.dir"     value="lib"/>
  <property name="build.dir"   value="build/classes"/>
  <property name="webroot.dir" value="WebRoot"/>
  <property name="webinf.dir"  value="${webroot.dir}/WEB-INF"/>

  <path id="classpath">
    <fileset dir="${lib.dir}" includes="**/*.jar"/>
  </path>

  <target name="init">
    <mkdir dir="${build.dir}"/>
  </target>

  <target name="compile" depends="init"
          description="Compile Java sources with the configured JDK.">
    <!--
      Source/target level: defaults to 1.6 to match the legacy
      Kairo target on Windows 10 + JDK 6, but can be overridden
      via the KAIRO_JAVA_TARGET env var or -Dkairo.java.target
      Ant property. The override is required for newer JDKs
      (9+) that removed support for `source=1.6`. The K4 macOS
      regression environment ships a modern JDK so we let it
      bump the level to 1.8 by setting KAIRO_JAVA_TARGET=1.8
      in the test harness.
    -->
    <property environment="env"/>
    <condition property="kairo.java.target" value="${env.KAIRO_JAVA_TARGET}" else="1.6">
      <isset property="env.KAIRO_JAVA_TARGET"/>
    </condition>
    <javac srcdir="${src.dir}"
           destdir="${build.dir}"
           includeantruntime="false"
           source="${kairo.java.target}"
           target="${kairo.java.target}"
           encoding="UTF-8"
           debug="true"
           classpathref="classpath">
      <compilerarg value="-Xlint:all"/>
    </javac>
    <copy todir="${build.dir}">
      <fileset dir="${res.dir}"/>
    </copy>
    <!-- KAIRO-RC-WEB-2026-07-26-07: keep WebRoot/WEB-INF/classes in sync
         so the embedded Tomcat server serves freshly compiled bytecode
         without requiring a separate package step. -->
    <copy todir="${webinf.dir}/classes">
      <fileset dir="${build.dir}"/>
    </copy>
  </target>

  <target name="clean" description="Remove build artifacts.">
    <delete dir="${build.dir}"/>
  </target>

  <target name="package" depends="compile"
          description="Build a deployable webapp directory under dist/.">
    <mkdir dir="dist"/>
    <copy todir="dist/webapp">
      <fileset dir="${webroot.dir}"/>
    </copy>
    <copy todir="dist/webapp/WEB-INF/classes">
      <fileset dir="${build.dir}"/>
    </copy>
    <copy todir="dist/webapp/WEB-INF/lib" flatten="true">
      <fileset dir="${lib.dir}" includes="**/*.jar"/>
    </copy>
  </target>

</project>
