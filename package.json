{
  "name": "kairo-ide",
  "version": "0.1.0",
  "description": "Kairo IDE — desktop entry. Electron shell + Theia frontend + in-process Go Runtime Agent.",
  "private": true,
  "main": "apps/desktop/lib/main.js",
  "author": "Kairo IDE",
  "license": "Apache-2.0",
  "scripts": {
    "bundled:prepare": "pwsh -ExecutionPolicy Bypass -File scripts/prepare-bundled.ps1",
    "package:win": "pwsh -ExecutionPolicy Bypass -File scripts/build-and-package.ps1",
    "package:win:skip-build": "pwsh -ExecutionPolicy Bypass -File scripts/build-and-package.ps1 -SkipBuild",
    "clean": "pnpm -r --filter \"./packages/*\" --if-present run clean",
    "build": "pnpm -r --filter \"./packages/*\" --if-present run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" exec tsc --noEmit && pnpm --filter @kairo/desktop exec tsc -p tsconfig.json --noEmit",
    "lint": "pnpm -r --filter \"./packages/*\" --if-present run lint",
    "test": "node --test tests/**/*.test.cjs tests/**/*.test.ts",
    "test:tmp-setup": "node -e \"require('./tests/setup-tmp.cjs'); console.log('KAIRO_TMP =', process.env.KAIRO_TMP); console.log('os.tmpdir() =', require('os').tmpdir());\"",
    "clean:c-drive": "pwsh -ExecutionPolicy Bypass -File scripts/clean-c-drive.ps1",
    "clean:c-drive:dry": "pwsh -ExecutionPolicy Bypass -File scripts/clean-c-drive.ps1 -DryRun"
  },
  "dependencies": {
    "@kairo/protocol": "workspace:*",
    "@kairo/theia-product": "workspace:*",
    "@kairo/runtime-extension": "workspace:*",
    "@theia/core": "1.73.1",
    "@theia/electron": "1.73.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.1",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "rimraf": "5.0.10",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "react-dom": "18.3.1",
      "typescript": "7.0.2",
      "drivelist": "workspace:*",
      "puppeteer-core": "21.11.0",
      "puppeteer": "21.11.0"
    }
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
