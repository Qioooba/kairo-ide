{
  "name": "kairo-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Kairo IDE — a cross-platform IDE for legacy Java Web projects (JDK 1.6 / Tomcat 6 / JSP / Servlet / GBK)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile=false",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "build:agent": "pnpm --filter @kairo/runtime-agent build",
    "build:product": "pnpm --filter @kairo/theia-product build",
    "dev:browser": "pnpm --filter @kairo/browser start",
    "dev:server": "pnpm --filter @kairo/theia-product start:server",
    "test": "pnpm -r --filter \"./packages/*\" test && pnpm -r --filter \"./apps/*\" test",
    "test:agent": "node scripts/test-agent.js",
    "test:agent:unit": "cd runtime-agent && go test -count=1 -timeout 300s ./...",
    "test:agent:race": "cd runtime-agent && go test -race -count=1 -timeout 420s ./...",
    "test:agent:integration": "cd runtime-agent && go test -timeout 240s -tags=integration ./test/...",
    "test:e2e:api": "pnpm --filter @kairo/e2e test:api",
    "test:e2e:web": "pnpm --filter @kairo/e2e test:ui",
    "test:e2e:smoke": "pnpm --filter @kairo/e2e test:smoke",
    "test:e2e:playwright": "pnpm --filter @kairo/e2e test:playwright",
    "test:e2e:core": "pnpm --filter @kairo/e2e test:core",
    "test:visual:web": "pnpm --filter @kairo/e2e test:visual",
    "test:a11y:web": "pnpm --filter @kairo/e2e test:a11y",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}' --max-warnings 0",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx,css}'",
    "clean": "pnpm -r exec rm -rf lib out gen dist && rm -rf runtime-agent/bin runtime-agent/dist && pnpm -r exec sh -c 'rm -f tsconfig.tsbuildinfo *.tsbuildinfo' 2>/dev/null; true",
    "verify": "pnpm install --frozen-lockfile && pnpm build && pnpm test && pnpm test:agent && pnpm lint",
    "agent:run": "cd runtime-agent && go run ./cmd/kairo-runtime --config ../runtime-agent/configs/dev.yaml",
    "agent:build": "cd runtime-agent && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o bin/kairo-runtime ./cmd/kairo-runtime",
    "bundled:prepare": "if command -v pwsh >/dev/null 2>&1; then pwsh -ExecutionPolicy Bypass -File scripts/prepare-bundled.ps1; else bash scripts/prepare-bundled.sh; fi",
    "bundled:check": "if command -v pwsh >/dev/null 2>&1; then pwsh -ExecutionPolicy Bypass -File scripts/prepare-bundled.ps1 -Strict; else bash scripts/prepare-bundled.sh --strict; fi",
    "bundled:verify": "node scripts/verify-bundled-dependencies.cjs",
    "supply-chain:test": "node --test scripts/supply-chain.test.cjs",
    "supply-chain:sbom": "node scripts/generate-sbom.cjs",
    "supply-chain:sign": "node scripts/sign-release.cjs",
    "supply-chain:verify-reproducible": "node scripts/verify-reproducible.cjs",
    "supply-chain:release": "node scripts/generate-sbom.cjs && node scripts/sign-release.cjs",
    "baseline:release": "node scripts/run-release-baseline.cjs",
    "qa:start": "bash scripts/start-qa-stack.sh",
    "qa:stop": "bash scripts/stop-qa-stack.sh",
    "build:win": "bash scripts/build-windows.sh",
    "package:win": "bash scripts/package-windows.sh",
    "dist:win": "bash scripts/build-windows.sh && bash scripts/package-windows.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/node": "20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.7.0",
    "playwright": "^1.61.1",
    "prettier": "3.9.6",
    "rimraf": "5.0.10",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "react-dom": "18.3.1",
      "typescript": "7.0.2",
      "drivelist": "workspace:*",
      "puppeteer-core": "21.11.0",
      "puppeteer": "21.11.0"
    },
    "patchedDependencies": {}
  }
}
