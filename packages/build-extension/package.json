{
  "name": "@kairo/build-extension",
  "version": "0.1.0",
  "description": "Kairo Build extension — build store, build view widget, and build lifecycle management.",
  "main": "lib/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ./test/register-hooks.mjs --test src/browser/build-store-map.test.cjs"
  },
  "dependencies": {
    "@kairo/protocol": "workspace:*",
    "@kairo/runtime-extension": "workspace:*",
    "@kairo/project-extension": "workspace:*",
    "@kairo/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@theia/core": "1.73.1"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "typescript": "5.5.4"
  }
}
