{
  "name": "@kairo/config-schema",
  "version": "0.1.0",
  "description": "JSON Schema for .legacyflow/project.yaml �?the canonical project configuration file. Generated into Theia form-fillers, used by the Go agent to validate configs.",
  "main": "lib/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --require ts-node/register --require source-map-support/register --test src/index.test.ts"
  },
  "dependencies": {
    "@kairo/protocol": "workspace:*",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "@types/node": "20.14.10"
  }
}

