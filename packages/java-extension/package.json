{
  "name": "@kairo/java-extension",
  "version": "0.1.0",
  "description": "Kairo Java extension �?owns the JDT Language Server lifecycle (delegated to the agent) and the Java activity bar.",
  "main": "lib/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/common/lsp-protocol.test.cjs src/node/jdt-ls-manager.test.cjs src/browser/*.test.cjs"
  },
  "dependencies": {
    "@kairo/project-extension": "workspace:*",
    "@kairo/protocol": "workspace:*",
    "@kairo/runtime-extension": "workspace:*",
    "@theia/monaco-editor-core": "1.108.201",
    "vscode-jsonrpc": "8.2.0"
  },
  "peerDependencies": {
    "@theia/core": "1.73.1"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  },
  "theiaExtensions": [
    {
      "backend": "lib/node/java-ls-backend-module"
    }
  ]
}
