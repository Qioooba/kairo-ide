{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "composite": true,
    "skipLibCheck": true,
    "jsx": "react",
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "lib", "**/*.test.ts"],
  "references": [
    { "path": "../i18n" },
    { "path": "../project-extension" },
    { "path": "../protocol" },
    { "path": "../runtime-extension" }
  ]
}
