{
  "name": "@kairo/jsp-extension",
  "version": "0.1.0",
  "description": "Kairo JSP / Taglib / EL support. Provides a Monarch grammar for syntax highlight, a TLD / web.xml parser for taglib completion, and the encoding-aware save flow.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["lib", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests\" && exit 0"
  },
  "dependencies": {
    "@kairo/protocol": "workspace:*",
    "@kairo/runtime-extension": "workspace:*"
  },
  "peerDependencies": {
    "@theia/core": "1.73.1",
    "@theia/monaco": "1.73.1"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  }
}
