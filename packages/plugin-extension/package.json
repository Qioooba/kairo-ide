{
  "name": "@kairo/plugin-extension",
  "version": "0.1.0",
  "description": "Kairo IDE — VS Code extension compatibility layer. Local .vsix installation, extension management, allowlist-based curation.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "theiaExtensions": [
    {
      "frontend": "lib/index",
      "backend": "lib/node/kairo-extensions-backend-module"
    }
  ],
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --require ts-node/register --require source-map-support/register --test test/extension-installer.test.ts test/extension-scanner.test.ts test/allowlist.test.ts"
  },
  "dependencies": {
    "@kairo/i18n": "workspace:*",
    "@kairo/protocol": "workspace:*",
    "@theia/core": "1.73.1",
    "@theia/plugin-ext": "1.73.1",
    "@theia/plugin-ext-vscode": "1.73.1",
    "@theia/workspace": "1.73.1",
    "adm-zip": "^0.5.16",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/semver": "^7.7.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2"
  }
}