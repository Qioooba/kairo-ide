{
  "name": "java-properties",
  "displayName": "Java Properties Syntax Highlighting",
  "description": "Syntax highlighting for .properties files (Java properties format)",
  "version": "1.0.0",
  "publisher": "kairo-test",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:properties"
  ],
  "contributes": {
    "languages": [{
      "id": "properties",
      "aliases": ["Java Properties", "properties"],
      "extensions": [".properties", ".properties.default", ".properties.prod"],
      "filenames": [],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "properties",
      "scopeName": "source.properties",
      "path": "./syntaxes/properties.tmLanguage.json"
    }]
  }
}