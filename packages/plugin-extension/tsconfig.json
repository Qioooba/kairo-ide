{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "composite": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "jsx": "react"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "lib", "**/*.test.ts"],
  "references": [
    { "path": "../protocol" },
    { "path": "../i18n" }
  ]
}