{
  "name": "@kairo/runtime-extension",
  "version": "0.1.0",
  "description": "Kairo runtime extension �?owns the HTTP/WS client to the Go Runtime Agent. The rest of the UI uses this client and never talks to /api/v1 directly.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node ../../scripts/clean-dir.cjs lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --require ./test-setup.cjs --test src/browser/runtime.test.cjs src/browser/runtime-exports-extended.test.cjs src/browser/workspace-context-service.test.cjs src/browser/runtime-errors-extended.test.cjs src/browser/runtime-connection-service.test.cjs src/browser/runtime-security.test.cjs",
    "test:dynamic": "node --require ./test-setup.cjs --test src/browser/runtime-dynamic-routes.test.cjs",
    "test:mocha": "mocha",
    "test:all": "pnpm run test:mocha && pnpm run test && pnpm run test:dynamic"
  },
  "dependencies": {
    "@kairo/protocol": "workspace:*",
    "@kairo/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@theia/core": "1.73.1"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "jsdom": "30.0.1",
    "jsdom-global": "3.0.2",
    "mocha": "11.7.6",
    "typescript": "7.0.2"
  }
}
