{
  "name": "@kairo/runtime-extension",
  "version": "0.1.0",
  "description": "Kairo runtime extension �?owns the HTTP/WS client to the Go Runtime Agent. The rest of the UI uses this client and never talks to /api/v1 directly.",
  "main": "lib/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --require ./test-setup.cjs --test src/browser/runtime.test.cjs src/browser/runtime-dynamic-routes.test.cjs",
    "test:mocha": "mocha",
    "test:all": "pnpm run test:mocha && pnpm run test"
  },
  "dependencies": {
    "@kairo/protocol": "workspace:*",
    "@kairo/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@theia/core": "1.73.1"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "jsdom": "24.1.3",
    "jsdom-global": "3.0.2",
    "mocha": "10.8.2",
    "typescript": "5.5.4"
  }
}
