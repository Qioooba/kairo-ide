{
  "name": "@kairo/search-extension",
  "version": "0.1.0",
  "description": "Kairo full-text search UI. Talks to /api/v1/search via the runtime client; renders the standard search-in-workspace widget with replace preview.",
  "main": "lib/index.js",
  "types": "lib/src/index.d.ts",
  "files": ["lib", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --require source-map-support/register --test src/browser/search-service.test.cjs"
  },
  "dependencies": {
    "@kairo/protocol": "workspace:*",
    "@kairo/runtime-extension": "workspace:*"
  },
  "peerDependencies": {
    "@theia/core": "1.73.1",
    "@theia/editor": "1.73.1"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  }
}

