{
  "name": "@kairo/search-extension",
  "version": "0.1.0",
  "description": "Kairo full-text search UI. Talks to /api/v1/search via the runtime client; renders the standard search-in-workspace widget with replace preview.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["lib", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/browser/search-center.css','lib/browser/search-center.css')\"",
    "clean": "rm -rf lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --require source-map-support/register --test src/browser/search-service.test.cjs src/browser/search-session-model.test.cjs src/browser/search-center-widget.test.cjs src/browser/search-everywhere-model.test.cjs src/browser/search-everywhere-providers.test.cjs src/browser/search-replace-service.test.cjs src/browser/search-exports-extended.test.cjs"
  },
  "dependencies": {
    "@kairo/protocol": "workspace:*",
    "@kairo/java-extension": "workspace:*",
    "@kairo/runtime-extension": "workspace:*",
    "@kairo/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@theia/core": "1.73.1",
    "@theia/editor": "1.73.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
