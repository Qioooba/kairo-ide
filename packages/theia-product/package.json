{
  "name": "@kairo/theia-product",
  "version": "0.1.0",
  "description": "Kairo IDE 鈥?the Theia product composition. Wires the Kairo extensions into a Theia application, runs in browser and desktop forms.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/index"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests\" && exit 0",
    "start:browser": "theia start /tmp/kairo-workspace --hostname=0.0.0.0 --port=3000",
    "start:server": "theia start /var/lib/kairo/workspaces --hostname=0.0.0.0 --port=8443"
  },
  "dependencies": {
    "@kairo/config-schema": "workspace:*",
    "@kairo/project-extension": "workspace:*",
    "@kairo/runtime-extension": "workspace:*",
    "@kairo/search-extension": "workspace:*",
    "@kairo/jsp-extension": "workspace:*",
    "@kairo/tomcat-extension": "workspace:*",
    "@kairo/java-extension": "workspace:*",
    "@kairo/ui-kit": "workspace:*",
    "@kairo/protocol": "workspace:*",
    "@theia/core": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/workspace": "1.73.1",
    "@theia/terminal": "1.73.1",
    "@theia/debug": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/messages": "1.73.1",
    "@theia/preferences": "1.73.1",
    "@theia/markers": "1.73.1",
    "@theia/outline-view": "1.73.1",
    "@theia/search-in-workspace": "1.73.1",
    "@theia/navigator": "1.73.1",
    "@theia/variable-resolver": "1.73.1"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  }
}

