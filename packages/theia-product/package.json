{
  "name": "@kairo/theia-product",
  "version": "0.1.0",
  "description": "Kairo IDE — the Theia product composition. Wires the Kairo extensions into a Theia application, runs in browser and desktop forms.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/index",
      "backend": "lib/node/kairo-product-backend-module"
    }
  ],
  "scripts": {
    "build": "tsc -b --force && node ../../scripts/copy-css.cjs src/main/browser lib/browser",
    "clean": "node ../../scripts/clean-dir.cjs lib tsconfig.tsbuildinfo",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/main/browser/kairo-commands.test.cjs src/main/browser/kairo-file-commands.test.cjs src/main/browser/kairo-settings-service.test.cjs src/main/browser/large-file-policy.test.cjs src/main/browser/kairo-java-debug-service.test.cjs src/main/browser/kairo-debug-native-wiring.test.cjs src/main/browser/kairo-run-configuration-service.test.cjs src/main/node/kairo-java-debug-adapter.test.cjs src/main/node/kairo-agent-config-contribution.test.cjs src/main/browser/theia-product-exports.test.cjs src/main/browser/kairo-terminal-integration.test.cjs src/main/browser/kairo-inlay-hints-codelens.test.cjs src/main/browser/kairo-compliance-widget.test.cjs src/main/browser/kairo-widget-interactions.test.cjs src/main/browser/kairo-frontend-module.test.cjs && node --import ./test/register-hooks.mjs --test src/main/browser/kairo-composition.test.cjs src/main/browser/kairo-problems-widget.test.cjs src/main/browser/kairo-breadcrumbs.test.cjs",
    "start:browser": "node ../../apps/browser/scripts/start.cjs",
    "start:server": "theia start /var/lib/kairo/workspaces --hostname=127.0.0.1 --port=8443"
  },
  "dependencies": {
    "@kairo/build-extension": "workspace:*",
    "@kairo/config-schema": "workspace:*",
    "@kairo/encoding-extension": "workspace:*",
    "@kairo/git-extension": "workspace:*",
    "@kairo/highlighting-extension": "workspace:*",
    "@kairo/i18n": "workspace:*",
    "@kairo/java-extension": "workspace:*",
    "@kairo/jsp-extension": "workspace:*",
    "@kairo/plugin-extension": "workspace:*",
    "@kairo/project-extension": "workspace:*",
    "@kairo/protocol": "workspace:*",
    "@kairo/runtime-extension": "workspace:*",
    "@kairo/search-extension": "workspace:*",
    "@kairo/svn-extension": "workspace:*",
    "@kairo/test-extension": "workspace:*",
    "@kairo/tomcat-extension": "workspace:*",
    "@kairo/ui-kit": "workspace:*",
    "@theia/core": "1.73.1",
    "@theia/debug": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/plugin-ext": "1.73.1",
    "@theia/plugin-ext-vscode": "1.73.1",
    "@theia/scm": "1.73.1",
    "@theia/markers": "1.73.1",
    "@theia/messages": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/monaco-editor-core": "1.108.201",
    "@theia/navigator": "1.73.1",
    "@theia/outline-view": "1.73.1",
    "@theia/preferences": "1.73.1",
    "@theia/search-in-workspace": "1.73.1",
    "@theia/terminal": "1.73.1",
    "@theia/variable-resolver": "1.73.1",
    "@theia/workspace": "1.73.1"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "5.5.4"
  }
}
