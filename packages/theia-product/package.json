{
  "name": "@kairo/theia-product",
  "version": "0.1.0",
  "description": "Kairo IDE — the Theia product composition. Wires the Kairo extensions into a Theia application, runs in browser and desktop forms.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/index",
      "backend": "lib/node/kairo-product-backend-module"
    }
  ],
  "scripts": {
    "build": "tsc -b --force",
    "clean": "rm -rf lib tsconfig.tsbuildinfo",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/main/browser/kairo-commands.test.cjs src/main/browser/kairo-file-commands.test.cjs src/main/browser/large-file-policy.test.cjs src/main/browser/kairo-java-debug-service.test.cjs src/main/browser/kairo-debug-native-wiring.test.cjs src/main/browser/kairo-run-configuration-service.test.cjs src/main/node/kairo-java-debug-adapter.test.cjs && node --import ./test/register-hooks.mjs --test src/main/browser/kairo-composition.test.cjs",
    "start:browser": "theia start /tmp/kairo-workspace --hostname=127.0.0.1 --port=3000",
    "start:server": "theia start /var/lib/kairo/workspaces --hostname=127.0.0.1 --port=8443"
  },
  "dependencies": {
    "@kairo/build-extension": "workspace:*",
    "@kairo/config-schema": "workspace:*",
    "@kairo/java-extension": "workspace:*",
    "@kairo/jsp-extension": "workspace:*",
    "@kairo/project-extension": "workspace:*",
    "@kairo/protocol": "workspace:*",
    "@kairo/runtime-extension": "workspace:*",
    "@kairo/search-extension": "workspace:*",
    "@kairo/tomcat-extension": "workspace:*",
    "@kairo/ui-kit": "workspace:*",
    "@theia/core": "1.73.1",
    "@theia/debug": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/git": "1.73.1",
    "@theia/scm": "1.73.1",
    "@theia/markers": "1.73.1",
    "@theia/messages": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/monaco-editor-core": "1.108.201",
    "@theia/navigator": "1.73.1",
    "@theia/outline-view": "1.73.1",
    "@theia/preferences": "1.73.1",
    "@theia/search-in-workspace": "1.73.1",
    "@theia/terminal": "1.73.1",
    "@theia/variable-resolver": "1.73.1",
    "@theia/workspace": "1.73.1"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "5.5.4"
  }
}
