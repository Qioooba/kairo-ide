    "test": "echo \"no tests\" && exit 0"
  },
  "dependencies": {
    "@theia/core": "1.73.1"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  }
}
