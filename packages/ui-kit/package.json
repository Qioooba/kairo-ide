{
  "name": "@kairo/ui-kit",
  "version": "0.1.0",
  "description": "Kairo design tokens, theme constants, and reusable layout primitives. Theia extensions import from here instead of hardcoding colors.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/browser/index"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/browser/*.css lib/browser/",
    "clean": "rm -rf lib",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --require ts-node/register --require source-map-support/register --test src/browser/kairo-theme.test.ts"
  },
  "dependencies": {
    "@theia/core": "1.73.1"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  }
}
