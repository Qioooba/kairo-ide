<?xml version="1.0" encoding="UTF-8"?>
<project name="legacy-webapp" default="dist" basedir=".">

  <property name="src.dir"     value="src/main/java"/>
  <property name="lib.dir"     value="lib"/>
  <property name="build.dir"   value="build/classes"/>
  <property name="web.dir"     value="web"/>
  <property name="webinf.dir"  value="${web.dir}/WEB-INF"/>

  <path id="classpath">
    <fileset dir="${lib.dir}" includes="**/*.jar"/>
    <fileset dir="${webinf.dir}/lib" includes="**/*.jar"/>
  </path>

  <target name="init">
    <mkdir dir="${build.dir}"/>
  </target>

  <target name="compile" depends="init"
          description="Compile Java sources with source/target 1.6.">
    <javac srcdir="${src.dir}"
           destdir="${build.dir}"
           includeantruntime="false"
           source="1.6"
           target="1.6"
           encoding="GBK"
           classpathref="classpath">
      <compilerarg value="-Xlint:all"/>
    </javac>
  </target>

  <target name="clean" description="Remove build artifacts.">
    <delete dir="${build.dir}"/>
    <delete dir="dist"/>
  </target>

  <target name="dist" depends="compile"
          description="Build a deployable WAR layout under dist/.">
    <mkdir dir="dist/webapp"/>
    <copy todir="dist/webapp">
      <fileset dir="${web.dir}"/>
    </copy>
    <copy todir="dist/webapp/WEB-INF/classes">
      <fileset dir="${build.dir}"/>
    </copy>
    <copy todir="dist/webapp/WEB-INF/lib" flatten="true">
      <fileset dir="${lib.dir}" includes="**/*.jar"/>
    </copy>
    <copy todir="dist/webapp/WEB-INF/lib" flatten="true">
      <fileset dir="${webinf.dir}/lib" includes="**/*.jar"/>
    </copy>
  </target>

  <target name="war" depends="dist"
          description="Create a .war file.">
    <jar destfile="dist/${ant.project.name}.war"
         basedir="dist/webapp"/>
  </target>

</project>