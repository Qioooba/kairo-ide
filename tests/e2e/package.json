{
  "name": "@kairo/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end smoke for the Kairo IDE. The api-smoke is the CI-friendly back-end test; the ui-full-chain drives the real Theia Browser through Playwright.",
  "scripts": {
    "test:api": "node api-smoke.cjs",
    "test:ui": "node ui-full-chain.cjs",
    "test:smoke": "node theia-smoke.cjs",
    "test:visual": "node visual-regression.cjs",
    "test:a11y": "node a11y-scan.cjs",
    "test:playwright": "npx playwright test --config playwright.config.ts",
    "test:core": "npx playwright test --config playwright.config.ts --grep 'E2E-0[12459]'",
    "test:frontend": "npx playwright test --config playwright.config.ts frontend-e2e.spec.ts",
    "test:boundary": "npx playwright test --config playwright.config.ts boundary-e2e.spec.ts",
    "test:windows": "npx playwright test --config playwright.config.ts windows-e2e.spec.ts",
    "test:desktop": "npx playwright test --config desktop/playwright.config.ts",
    "test:all": "npx playwright test --config playwright.config.ts",
    "test:report": "node test-report.cjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1"
  }
}
