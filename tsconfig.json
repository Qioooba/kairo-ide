{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react"
  },
  // Root noEmit graph covers packages + apps (incl. apps/desktop).
  // CI type-check also runs @kairo/desktop tsc --noEmit (DK-P3-5).
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "tests/*/src/**/*.ts"
  ]
}
